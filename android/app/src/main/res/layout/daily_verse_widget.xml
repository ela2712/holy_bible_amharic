<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Row: Icon + App Name / Theme -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_theme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="የዕለቱ ቃል"
            android:textColor="#FBBF24"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="መጽሐፍ ቅዱስ"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Verse Text Body -->
    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:text="“በመጀመሪያ ቃል ነበረ፥ ቃልም በእግዚአብሔር ዘንድ ነበረ፥ ቃልም እግዚአብሔር ነበረ።”"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:ellipsize="end"
        android:maxLines="4" />

    <!-- Reference Row -->
    <TextView
        android:id="@+id/widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— የዮሐንስ ወንጌል 1:1"
        android:textColor="#FBBF24"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>
